# Writes a C++ file that holds the Unity-side sources as text.
#
# Each file is split into pieces of at most 8000 bytes, because some
# compilers limit how long one string literal may be.
function(vfx_embed_unity_files source_dir output)
    file(GLOB_RECURSE files RELATIVE "${source_dir}"
         "${source_dir}/Editor/*.cs" "${source_dir}/Runtime/*.cs" "${source_dir}/Shaders/*.shader" "${source_dir}/URP/*.cs" "${source_dir}/URP/*.asmdef" "${source_dir}/README.txt")
    list(SORT files)
    set(body "// Generated by editor/EmbedUnityFiles.cmake from unity/. Do not edit.\n")
    string(APPEND body "#include \"vfx/editor/UnityFiles.h\"\n\nnamespace vfx::editor {\n\n")
    string(APPEND body "namespace {\n\nstd::string join(std::initializer_list<const char*> pieces) {\n")
    string(APPEND body "    std::string out;\n    for (const char* p : pieces) {\n        out += p;\n    }\n    return out;\n}\n\n}  // namespace\n\n")
    string(APPEND body "const std::vector<UnityFile>& unityHelperSources() {\n    static const std::vector<UnityFile> files = {\n")
    foreach(file IN LISTS files)
        file(READ "${source_dir}/${file}" content)
        string(REPLACE "\r\n" "\n" content "${content}")
        string(LENGTH "${content}" size)
        string(APPEND body "        {\"${file}\", join({\n")
        set(at 0)
        while(at LESS size)
            string(SUBSTRING "${content}" ${at} 8000 piece)
            string(APPEND body "R\"vfxforge(${piece})vfxforge\",\n")
            math(EXPR at "${at} + 8000")
        endwhile()
        string(APPEND body "        })},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_dir}/${file}")
    endforeach()
    string(APPEND body "    };\n    return files;\n}\n\n}  // namespace vfx::editor\n")
    file(WRITE "${output}.new" "${body}")
    file(COPY_FILE "${output}.new" "${output}" ONLY_IF_DIFFERENT)
endfunction()

# Writes a C++ file with one text file inside it, as `const std::string& <function>()`.
function(vfx_embed_text input output function)
    file(READ "${input}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(LENGTH "${content}" size)
    set(body "// Generated by editor/EmbedUnityFiles.cmake from ${input}. Do not edit.\n#include <string>\n\n")
    string(APPEND body "namespace vfx::editor::shader {\n\nconst std::string& ${function}() {\n    static const std::string text = std::string()\n")
    set(at 0)
    while(at LESS size)
        string(SUBSTRING "${content}" ${at} 8000 piece)
        string(APPEND body "        + R\"vfxforge(${piece})vfxforge\"\n")
        math(EXPR at "${at} + 8000")
    endwhile()
    string(APPEND body "        ;\n    return text;\n}\n\n}  // namespace vfx::editor::shader\n")
    file(WRITE "${output}.new" "${body}")
    file(COPY_FILE "${output}.new" "${output}" ONLY_IF_DIFFERENT)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
endfunction()
