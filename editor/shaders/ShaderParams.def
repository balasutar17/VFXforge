// ---------------------------------------------------------------- 20 Layer shader
// Eight layers, each of 21 values in this order (the shared source reads them by offset):
//  el on blend opacity colA colB intensity size aspect thick soft count rot spin speed warp twist ox oy space invert
VFX_FAMILY(LY)
VFX_C(LY, glow, "Glow colour", "Colour of the rim light and core glow", 0.35, 0.65, 1.0, 1)
VFX_F(LY, rimIntensity, "Rim light", "Light round the edge of the object", 0, 4, 0, 0)
VFX_F(LY, rimPower, "Rim width", "Higher keeps the rim thin", 0.5, 8, 2.5, 1)
VFX_F(LY, coreGlow, "Core glow", "Extra glow in the middle of the object", 0, 2, 0, 0)
VFX_F(LY, brightness, "Brightness", "Multiplies every layer (above 1 is HDR and blooms)", 0, 4, 1, 0)
VFX_F(LY, opacity, "Overall opacity", "Fades the whole shader", 0, 1, 1, 0)
VFX_CH(LY, L0_el, "Element", "What this layer draws", 0, "None|Circle|Ring|Segmented ring|Spiral|Star|Polygon|Hex grid|Grid|Stripes|Speed lines|Wave|Beam|Radar sweep|Lightning|Orbiting dots|Shockwave|Linear gradient|Radial gradient|Angular gradient|Fresnel glow|Height gradient|Noise|Cells|Plasma|Halftone dots|Checker|Solid colour")
VFX_CH(LY, L0_on, "Visible", "Turn the layer off to compare", 1, "Off|On")
VFX_CH(LY, L0_blend, "Blend", "How the layer combines with the layers below it", 0, "Add|Alpha|Multiply|Screen|Mask|Erase")
VFX_F(LY, L0_opacity, "Opacity", "How strongly the layer shows", 0, 1, 1, 0)
VFX_C(LY, L0_colA, "Colour A", "The first colour (and its opacity) of the layer", 0.20, 0.60, 1.0, 1)
VFX_C(LY, L0_colB, "Colour B", "The second colour: the layer blends from A to B", 1.0, 1.0, 1.0, 1)
VFX_F(LY, L0_intensity, "Brightness", "Light of this layer (above 1 is HDR and blooms)", 0, 8, 1.5, 0)
VFX_F(LY, L0_size, "Size", "Size of the layer", 0.05, 3, 0.8, 0)
VFX_F(LY, L0_aspect, "Stretch", "Stretches the layer sideways (above 1) or upright (below 1)", 0.2, 5, 1, 1)
VFX_F(LY, L0_thick, "Thickness", "Line or fill amount", 0.01, 1, 0.25, 0)
VFX_F(LY, L0_soft, "Edge softness", "How soft the edge is", 0, 1, 0.25, 0)
VFX_F(LY, L0_count, "Count", "Segments, points, lines or scale of the pattern", 1, 32, 6, 0)
VFX_F(LY, L0_rot, "Rotation", "Turns the layer, in degrees", -180, 180, 0, 0)
VFX_F(LY, L0_spin, "Spin speed", "Degrees per second", -360, 360, 0, 0)
VFX_F(LY, L0_speed, "Motion speed", "How fast the layer moves, scrolls or expands", -4, 4, 0.5, 0)
VFX_F(LY, L0_warp, "Distortion", "Warps the layer with noise", 0, 1, 0, 0)
VFX_F(LY, L0_twist, "Twist", "Turns the layer more towards its middle", -4, 4, 0, 1)
VFX_F(LY, L0_ox, "Offset X", "Moves the layer sideways", -1.5, 1.5, 0, 1)
VFX_F(LY, L0_oy, "Offset Y", "Moves the layer up or down", -1.5, 1.5, 0, 1)
VFX_CH(LY, L0_space, "Projection", "How the layer is laid onto the object", 0, "Mesh UV|Front (object XY)|Top (object XZ)|Wrap (longitude / latitude)")
VFX_CH(LY, L0_invert, "Shape", "Normal, or swap inside and outside", 0, "Normal|Inverted")
