VFX_C(EM, color3, "Tertiary colour", "The brightest veins", 1.0, 0.96, 0.70, 1)
VFX_F(EM, intensity, "Glow intensity", "Brightness of the emission (above 1 is HDR and blooms)", 0, 8, 2.2, 0)
VFX_F(EM, rimIntensity, "Rim light", "Light round the edge of the object", 0, 4, 0.8, 0)
VFX_F(EM, rimPower, "Rim width", "Higher keeps the rim thin", 0.5, 8, 2.5, 1)
VFX_F(EM, patternScale, "Pattern scale", "Size of the energy pattern", 0.5, 12, 3.2, 0)
VFX_F(EM, veins, "Vein contrast", "How sharp the bright veins are", 0, 1, 0.7, 0)
VFX_F(EM, distortion, "Distortion", "How much the pattern is warped", 0, 1, 0.35, 0)
VFX_F(EM, coreGlow, "Core glow", "Extra brightness in the middle of the object", 0, 2, 0.6, 0)
VFX_CH(EM, pattern, "Pattern", "The kind of energy pattern", 0, "Swirl|Cells|Streaks")

