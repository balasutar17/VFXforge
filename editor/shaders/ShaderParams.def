// The parameters of every shader family, in one place. Included several times with different
// macro definitions: for the index constants the shader code reads them by, for the tables
// the editor and the exporter read, and for the exporter's property list.
//
// VFX_COMMON(key, label, tip, min, max, default, advanced)       every family has these first
// VFX_FAMILY(CODE)                                              starts a family
// VFX_F(CODE, key, label, tip, min, max, default, advanced)     a number
// VFX_C(CODE, key, label, tip, r, g, b, a)                      a colour (may be brighter than 1: HDR)
// VFX_CH(CODE, key, label, tip, default, "A|B|C")               a choice
//
// Keep the order: an index is the position in this file.

VFX_COMMON(speed, "Animation speed", "How fast everything moves; 0 freezes it", 0, 4, 1, 0)
VFX_COMMON(pulseAmp, "Pulse amount", "How much the glow swells and fades", 0, 1, 0.2, 0)
VFX_COMMON(pulseFreq, "Pulse speed", "Pulses per second", 0, 8, 1.2, 0)
VFX_COMMON(flowSpeed, "Flow speed", "How fast the pattern flows (negative flows the other way)", -3, 3, 0.35, 0)
VFX_COMMON(rotateSpeed, "Rotate speed", "How fast the pattern turns round the object", -3, 3, 0, 0)
VFX_COMMON(flicker, "Flicker", "Irregular flickering of the light", 0, 1, 0, 0)
VFX_COMMON(noiseAmt, "Noise", "Random variation added to the pattern", 0, 1, 0.25, 1)
VFX_COMMON(reveal, "Reveal", "0 is gone, 1 is fully shown: dissolves in and out", 0, 1, 1, 0)

