import QtQuick.Controls.Imagine.impl

T.ApplicationWindow {
    id: window

    background: NinePatchImage {
        width: window.width
        height: window.height

        source: Imagine.url + "applicationwindow-background"
        NinePatchImageSelector on source {
            states: [
                {"active": window.active}
            ]
        }
    }
